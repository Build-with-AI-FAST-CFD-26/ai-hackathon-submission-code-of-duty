rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'zobiamughal378@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // --- Validation Helpers ---

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['admin', 'founder', 'viewer'] &&
             data.createdAt == request.time;
    }

    function isValidIntegration(data) {
      return data.type in ['Slack', 'Jira', 'GoogleWorkspace'] &&
             data.status in ['connected', 'disconnected', 'error'] &&
             data.lastSync == request.time;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() <= 128 &&
             data.message is string && data.message.size() <= 1024 &&
             data.category in ['Lead', 'Deadline', 'AI', 'Decision', 'Meeting'] &&
             data.priority in ['URGENT', 'THIS-WEEK', 'IGNORE'] &&
             data.createdAt == request.time;
    }

    function isValidLead(data) {
      return data.company is string && data.company.size() <= 128 &&
             data.status is string && data.status.size() <= 64 &&
             data.notes is string && data.notes.size() <= 5000;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUserProfile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'permissions']) &&
                    (isOwner(userId) ? incoming().role == existing().role : true); // User cannot escalate own role
    }

    match /users/{userId}/integrations/{integrationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidIntegration(incoming());
      allow update: if isOwner(userId) && 
                    isValidIntegration(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastSync', 'config']);
      allow delete: if isOwner(userId);
    }

    match /notifications/{notificationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid && isValidNotification(incoming()));
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
    }

    match /audit_logs/{logId} {
      allow list: if isAdmin() || hasRole('founder');
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      // No updates or deletes allowed for audit logs
    }

    match /leads/{leadId} {
      allow list, get: if hasRole('founder') || isAdmin();
      allow create: if (hasRole('founder') || isAdmin()) && isValidLead(incoming());
      allow update: if (hasRole('founder') || isAdmin()) && 
                    isValidLead(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastTouch', 'nextFollowUp', 'notes']);
      allow delete: if isAdmin();
    }
  }
}
